option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: 'production'
  
  # Load balancer configuration (if using load balancer)
  aws:elbv2:listener:443:
    ListenerEnabled: 'false'
    # When ready for HTTPS, set to true and add your certificate
    # Protocol: HTTPS
    # SSLCertificateArns: arn:aws:acm:region:account:certificate/certificate_ID

